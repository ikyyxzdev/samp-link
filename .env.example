# Environment Variables for SA-MP Link Discord Bot

# Bot Configuration
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=samp_database

# Bot & Branding Configuration
BOT_NAME="SA-MP Link"
LOGO_LINK="https://your-domain.com/assets/logo.png"
BANNER_LINK="https://your-domain.com/assets/banner.png"

# Discord Role IDs
FOUNDER_ROLE="YOUR_FOUNDER_ROLE_ID"
ADMIN_ROLE="YOUR_ADMIN_ROLE_ID"
UCP_ROLE="YOUR_UCP_ROLE_ID"

# SA-MP Server Configuration
SERVER_IP="127.0.0.1:7777"

# SA-MP Database UCP Mapping
TABLE_UCP="players"
COLUMN_ID="id"
COLUMN_NAME_UCP="ucp_name"
COLUMN_VERIFY_CODE="verify_code"